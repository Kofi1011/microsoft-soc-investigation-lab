// Run each numbered query separately.
// Required data source: Microsoft Entra sign-in records in SigninLogs.
// Query 1 uses Sentinel's configured lookback; for manual runs, set
// the Logs UI time range explicitly. The rule retains TimeGenerated.

// 1. Saved lab detection.
// Sentinel configuration: every 10 minutes; look back 10 minutes.
// Nonzero ResultType comparisons match the recorded rule and were
// executed successfully during validation.
// This is a fixed-bin detection, not a rolling-window detection.
SigninLogs
| where ResultType != 0
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName)
    by IPAddress, bin(TimeGenerated, 10m)
| where TargetedUsers >= 3

// 2. Source-scoped authentication totals.
// Replace the documentation-only IP with the source under investigation.
// Set the Logs UI time range to the intended investigation scope.
// The placeholder will not reproduce the original lab counts.
let InvestigatedIP = "192.0.2.10";
SigninLogs
| where IPAddress == InvestigatedIP
| summarize
    FailedAttempts = countif(ResultType != 0),
    SuccessfulAttempts = countif(ResultType == 0),
    TargetedUsers = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName)

// 3. Detailed triage.
// The selected fields and sorting were executed during validation.
// Review failure reasons before interpreting nonzero results as
// invalid-password attempts.
let InvestigatedIP = "192.0.2.10";
SigninLogs
| where IPAddress == InvestigatedIP
| project TimeGenerated, UserPrincipalName, IPAddress,
          ResultType, ResultDescription, AppDisplayName
| order by TimeGenerated asc

// Query outputs can expose real account names and public source IPs.
// Review and sanitize outputs before publishing.
